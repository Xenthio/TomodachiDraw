@page "/debug"
@using TomodachiDraw.Services
@inject CanvasAPI CanvasAPI
@inject DebugController DebugController

<div class="debug-container">
    <h2>🐛 Canvas API Debug Panel</h2>
    
    <div class="debug-section">
        <h3>Mode</h3>
        <p>Current: <strong>@DebugController.ModeDisplay</strong></p>
        <button class="btn btn-primary" @onclick="() => DebugController.SetSafeMode()">Safe Mode</button>
        <button class="btn btn-primary" @onclick="() => DebugController.SetSpeedMode()">Speed Mode</button>
        <button class="btn btn-secondary" @onclick="() => DebugController.ToggleMode()">Toggle</button>
    </div>

    <div class="debug-section">
        <h3>Tool</h3>
        <button class="btn btn-sm" @onclick="() => DebugController.SetToolPencilAsync()">Pencil</button>
        <button class="btn btn-sm" @onclick="() => DebugController.SetToolFillAsync()">Fill</button>
        <button class="btn btn-sm" @onclick="() => DebugController.SetToolEraserAsync()">Eraser</button>
    </div>

    <div class="debug-section">
        <h3>Palette</h3>
        <button class="btn btn-sm" @onclick="() => DebugController.ActivatePaletteSlot0Async()">Slot 0</button>
        <button class="btn btn-sm" @onclick="() => DebugController.ActivatePaletteSlot1Async()">Slot 1</button>
        <button class="btn btn-sm" @onclick="() => DebugController.SetPaletteSlot0RedAsync()">Slot 0 → Red</button>
        <button class="btn btn-sm" @onclick="() => DebugController.SetPaletteSlot0BlackAsync()">Slot 0 → Black</button>
    </div>

    <div class="debug-section">
        <h3>Navigation</h3>
        <button class="btn btn-sm" @onclick="() => DebugController.NavigateToCentreAsync()">Centre (128, 128)</button>
        <button class="btn btn-sm" @onclick="() => DebugController.NavigateToOriginAsync()">Origin (0, 0)</button>
        <button class="btn btn-sm" @onclick="() => DebugController.NavigateToCornerAsync()">Corner (255, 255)</button>
    </div>

    <div class="debug-section">
        <h3>Drawing</h3>
        <button class="btn btn-sm" @onclick="() => DebugController.DrawPixelAsync()">Draw Pixel</button>
        <button class="btn btn-sm" @onclick="() => DebugController.FillAsync()">Fill</button>
    </div>

    <div class="debug-section">
        <h3>State</h3>
        <button class="btn btn-sm" @onclick="() => DebugController.RealignAsync()">Realign (home to 128,128)</button>
        <p class="state-info">@DebugController.GetStateInfo()</p>
    </div>

    <div class="debug-result">
        <h4>Result:</h4>
        <p>@DebugController.LastResult</p>
    </div>

    <div class="debug-nav">
        <a href="/">← Back to Draw</a>
    </div>
</div>

<style>
    .debug-container {
        max-width: 600px;
        margin: 2rem auto;
        padding: 1.5rem;
        background: #f5f5f5;
        border-radius: 8px;
        font-family: monospace;
    }

    .debug-section {
        margin-bottom: 1.5rem;
        padding: 1rem;
        background: white;
        border-radius: 4px;
        border-left: 4px solid #007bff;
    }

    .debug-section h3 {
        margin-top: 0;
        font-size: 0.9rem;
        color: #333;
    }

    .debug-section button {
        margin: 0.25rem;
        padding: 0.4rem 0.8rem;
        font-size: 0.85rem;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    .btn-primary {
        background: #007bff;
        color: white;
    }

    .btn-primary:hover {
        background: #0056b3;
    }

    .btn-secondary {
        background: #6c757d;
        color: white;
    }

    .btn-secondary:hover {
        background: #545b62;
    }

    .btn-sm {
        background: #28a745;
        color: white;
        padding: 0.35rem 0.6rem;
        font-size: 0.8rem;
    }

    .btn-sm:hover {
        background: #218838;
    }

    .state-info {
        margin: 0.5rem 0;
        padding: 0.5rem;
        background: #e9ecef;
        border-radius: 3px;
        font-size: 0.9rem;
    }

    .debug-result {
        margin-top: 1.5rem;
        padding: 1rem;
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 4px;
    }

    .debug-result h4 {
        margin: 0 0 0.5rem 0;
        font-size: 0.9rem;
    }

    .debug-result p {
        margin: 0;
        color: #333;
        word-wrap: break-word;
    }

    .debug-nav {
        margin-top: 2rem;
        text-align: center;
    }

    .debug-nav a {
        color: #007bff;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .debug-nav a:hover {
        text-decoration: underline;
    }
</style>
