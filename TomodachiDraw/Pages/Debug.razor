@page "/debug"
@using TomodachiDraw.Services
@inject CanvasAPI CanvasAPI
@inject DebugController DebugController

<div class="debug-container">
    <h2>🐛 Canvas API Debug</h2>
    <p>Mode: <strong>@(DebugController?.ModeDisplay ?? "?")</strong></p>
    <button class="btn" @onclick="() => { DebugController?.SetSafeMode(); }">Safe</button>
    <button class="btn" @onclick="() => { DebugController?.SetSpeedMode(); }">Speed</button>
    <p>@(DebugController?.LastResult ?? "Ready")</p>
    <a href="/">← Back</a>
</div>

<style>
    .debug-container { padding: 2rem; }
    .btn { margin: 0.5rem; padding: 0.5rem 1rem; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; }
    .btn:hover { background: #218838; }
</style>
